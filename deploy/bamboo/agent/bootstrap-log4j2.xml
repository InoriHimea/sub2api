<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <!-- Streams are filtered before vendor classes initialize; never add a file appender. -->
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT" follow="true">
      <PatternLayout pattern="%d{ISO8601} %-5level %logger - %msg%n%throwable" />
    </Console>
  </Appenders>
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="Console" />
    </Root>
  </Loggers>
</Configuration>
